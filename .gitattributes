# Auto-detect text files and normalize them to LF in the repo
* text=auto eol=lf

# Shell scripts ALWAYS LF -- CRITICAL: CRLF breaks them inside the container
*.sh text eol=lf
entrypoint.sh text eol=lf
deploy.sh text eol=lf

# Mark binary files explicitly (no normalization, no diff)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
